from lambytes import Bytes
from lamerrors import Result, Error

go! {
    import (
        "bytes"
        "context"
        "crypto/md5"
        "encoding/base64"
        "errors"
        "fmt"
        "io"
        "net/url"
        "os"
        "strings"
        "time"

        "github.com/aws/aws-sdk-go-v2/aws"
        "github.com/aws/aws-sdk-go-v2/config"
        "github.com/aws/aws-sdk-go-v2/credentials"
        "github.com/aws/aws-sdk-go-v2/service/s3"
        "github.com/aws/aws-sdk-go-v2/service/s3/types"
        "github.com/aws/smithy-go"
    )

    // s3ReadBody reads a response body of known ``size`` into one exactly
    // sized buffer (io.ReadAll starts at 512 bytes and re-grows, copying a
    // multi-MiB body many times). A shorter body is returned as is.
    func s3ReadBody(body io.Reader, size int64) ([]byte, error) {
        if size <= 0 {
            return io.ReadAll(body)
        }
        buf := make([]byte, size)
        n, err := io.ReadFull(body, buf)
        if err == io.EOF || err == io.ErrUnexpectedEOF {
            return buf[:n], nil
        }
        return buf[:n], err
    }

    // SSE-C header values (nil when the client has no customer key).
    func s3Ptr(v string) *string {
        if v == "" {
            return nil
        }
        return aws.String(v)
    }

    func s3SseAlg(key string) *string {
        if key == "" {
            return nil
        }
        return aws.String("AES256")
    }

    func s3Error(kind string, format string, args ...interface{}) *LAMMERGEIER.Error {
        return LAMMERGEIER.Error(kind, fmt.Sprintf(format, args...), nil)
    }

    func s3IsNotFound(err error) bool {
        var apiErr smithy.APIError
        if errors.As(err, &apiErr) {
            switch apiErr.ErrorCode() {
            case "NotFound", "NoSuchKey", "NoSuchBucket", "404":
                return true
            }
        }
        return false
    }

    // s3ErrorCode is the S3 error code of err ("" when it has none).
    func s3ErrorCode(err error) string {
        var apiErr smithy.APIError
        if errors.As(err, &apiErr) {
            return apiErr.ErrorCode()
        }
        return ""
    }

    // s3NoLockConfig: the bucket, object or version has no Object Lock
    // configuration, retention or legal hold (AWS, MinIO and SeaweedFS
    // spellings).
    func s3NoLockConfig(err error) bool {
        switch s3ErrorCode(err) {
        case "ObjectLockConfigurationNotFoundError", "NoSuchObjectLockConfiguration", "NoSuchObjectLegalHold", "InvalidRequest":
            return true
        }
        return false
    }

    // s3LockErrorKind: S3ObjectLocked when the store refused a change
    // because of a retention or legal hold, otherwise ``fallback``.
    func s3LockErrorKind(err error, fallback string) string {
        if s3ErrorCode(err) == "AccessDenied" {
            return "S3ObjectLocked"
        }
        return fallback
    }

    func s3VersionPtr(versionId string) *string {
        if versionId == "" {
            return nil
        }
        return aws.String(versionId)
    }
}

class S3Config {
    func init(self, accessKeyId: str = "", secretAccessKey: str = "", endpoint: str = "", bucket: str = "", region: str = "auto", publicEndpoint: str = "", usePathStyle: bool = true) {
        self.accessKeyId: str = accessKeyId
        self.secretAccessKey: str = secretAccessKey
        self.endpoint: str = endpoint
        self.publicEndpoint: str = publicEndpoint
        self.region: str = region
        self.bucket: str = bucket
        self.usePathStyle: bool = usePathStyle
    }

    static func fromEnv() -> S3Config {
        cfg: S3Config = S3Config()
        go! {
            cfg.AccessKeyId = os.Getenv("S3_ACCESS_KEY_ID")
            cfg.SecretAccessKey = os.Getenv("S3_SECRET_ACCESS_KEY")
            cfg.Endpoint = os.Getenv("S3_ENDPOINT")
            cfg.PublicEndpoint = os.Getenv("S3_PUBLIC_ENDPOINT")
            cfg.Bucket = os.Getenv("S3_BUCKET")
            if value, ok := os.LookupEnv("S3_REGION"); ok {
                cfg.Region = value
            }
            if value, ok := os.LookupEnv("S3_USE_PATH_STYLE"); ok {
                value = strings.ToLower(strings.TrimSpace(value))
                cfg.UsePathStyle = value != "0" && value != "false" && value != "no"
            }
            return cfg
        }
    }

    func isReady(self) -> bool {
        return self.accessKeyId != "" and self.secretAccessKey != "" and self.endpoint != "" and self.region != "" and self.bucket != ""
    }

    func validate(self) -> Result[bool] {
        if self.accessKeyId == "" {
            return Result.Err(Error("S3ConfigError", "S3_ACCESS_KEY_ID is required", None))
        }
        if self.secretAccessKey == "" {
            return Result.Err(Error("S3ConfigError", "S3_SECRET_ACCESS_KEY is required", None))
        }
        if self.endpoint == "" {
            return Result.Err(Error("S3ConfigError", "S3_ENDPOINT is required", None))
        }
        if self.region == "" {
            return Result.Err(Error("S3ConfigError", "S3_REGION is required", None))
        }
        if self.bucket == "" {
            return Result.Err(Error("S3ConfigError", "S3_BUCKET is required", None))
        }
        return Result.Ok(true)
    }
}

class S3Object {
    func init(self) {
        self.key: str = ""
        self.size: int = 0
        self.etag: str = ""
        self.lastModified: str = ""
        self.contentType: str = ""
        self.metadata: dict[str, str] = {}
    }
}

class S3Retention {
    #- The S3 Object Lock retention of one object version: ``mode`` is
       ``GOVERNANCE``, ``COMPLIANCE`` or ``""`` (no retention) and
       ``untilUnix`` the retain-until date (Unix seconds, 0 without one). -#
    func init(self, mode: str = "", untilUnix: int = 0) {
        self.mode: str = mode
        self.untilUnix: int = untilUnix
    }

    #- True while the retention still protects the version at ``nowUnix``. -#
    func isActive(self, nowUnix: int) -> bool {
        return self.mode != "" and self.untilUnix > nowUnix
    }

    func __str__(self) -> str {
        if self.mode == "" {
            return "S3Retention(none)"
        }
        return f"S3Retention({self.mode} until {self.untilUnix})"
    }
}

class S3ObjectLockConfig {
    #- A bucket's Object Lock configuration. ``enabled`` is false for a bucket
       created without Object Lock; ``defaultMode`` with ``defaultDays`` or
       ``defaultYears`` is the retention new versions get when the writer
       sets none. -#
    func init(self) {
        self.enabled: bool = false
        self.defaultMode: str = ""
        self.defaultDays: int = 0
        self.defaultYears: int = 0
    }
}

class S3ObjectVersion {
    #- One version (or delete marker) of an object in a versioned bucket. -#
    func init(self) {
        self.key: str = ""
        self.versionId: str = ""
        self.size: int = 0
        self.etag: str = ""
        self.lastModifiedUnix: int = 0
        self.isLatest: bool = false
        self.isDeleteMarker: bool = false
    }
}

class S3Part {
    #- One uploaded part of a multipart upload. ``etag`` is the value S3
       returned for the part and must be passed back unchanged to
       ``completeMultipartUpload``. -#
    func init(self, partNumber: int = 0, etag: str = "", size: int = 0) {
        self.partNumber: int = partNumber
        self.etag: str = etag
        self.size: int = size
    }
}

class S3ObjectReader {
    #- Incremental reader over an object body (or a byte range of it),
       returned by ``S3Client.open``. Read with ``readBytes``/``read`` until
       an empty chunk signals EOF, then ``close``. ``raw`` is the native
       ``io.ReadCloser`` for Go interop (for example ``io.Copy`` into an HTTP
       response); reading it directly bypasses the EOF bookkeeping. -#
    func init(self) {
        self.key: str = ""
        self.offset: int = 0
        self.size: int = -1
        self.objectSize: int = -1
        self.contentType: str = ""
        self.etag: str = ""
        self.raw: any = None
        self.closed: bool = false
        self.eof: bool = false
    }

    func readBytes(self, maxBytes: int = 65536) -> Result[bytes] {
        #- Read up to ``maxBytes`` bytes; an empty value means EOF. -#
        go! {
            if s.Closed || s.Eof {
                return LAMMERGEIER.Result.Ok([]byte{})
            }
            body, ok := s.Raw.(io.Reader)
            if !ok {
                return LAMMERGEIER.Result.Err(s3Error("S3StreamError", "read %q: reader is not open", s.Key))
            }
            limit := maxBytes
            if limit <= 0 {
                limit = 65536
            }
            buf := make([]byte, limit)
            for {
                n, err := body.Read(buf)
                if err == io.EOF {
                    s.Eof = true
                    return LAMMERGEIER.Result.Ok(buf[:n])
                }
                if err != nil {
                    s.Eof = true
                    return LAMMERGEIER.Result.Err(s3Error("S3StreamError", "read %q: %v", s.Key, err))
                }
                if n > 0 {
                    return LAMMERGEIER.Result.Ok(buf[:n])
                }
            }
        }
    }

    func read(self, maxBytes: int = 65536) -> Result[str] {
        #- ``readBytes`` returning the chunk as a binary-safe string. -#
        chunk: bytes = self.readBytes(maxBytes)?
        out: str = ""
        go! {
            out = string(chunk)
        }
        return Result.Ok(out)
    }

    func close(self) -> Result[bool] {
        #- Release the connection. Idempotent. -#
        if self.closed {
            return Result.Ok(true)
        }
        self.closed = true
        go! {
            if body, ok := s.Raw.(io.Closer); ok {
                if err := body.Close(); err != nil {
                    return LAMMERGEIER.Result.Err(s3Error("S3StreamError", "close %q: %v", s.Key, err))
                }
            }
        }
        return Result.Ok(true)
    }
}

class S3Client {
    func init(self) {
        self.cfg: S3Config = S3Config()
        self.raw: any = None
        self.connected: bool = false
        # SSE-C: base64 key and its MD5, "" = no customer key.
        self.sseKey: str = ""
        self.sseKeyMd5: str = ""
    }

    func withCustomerKey(self, hexKey: str) -> Result[S3Client] {
        #- A client sharing this connection whose object operations use
           server-side encryption with a customer-provided key (SSE-C,
           AES-256): ``hexKey`` is 32 bytes as 64 hex characters. The store
           keeps only a hash of the key; reading the object needs the same
           key, so losing it loses the data. Presigned URLs are refused
           (they cannot carry the key). ``""`` returns a client without key. -#
        clone: S3Client = S3Client()
        clone.cfg = self.cfg
        clone.raw = self.raw
        clone.connected = self.connected
        if hexKey == "" {
            return Result.Ok(clone)
        }
        raw: str = Bytes.hexDecode(hexKey.trim().toLower())?
        if len(raw) != 32 {
            return Result.Err(Error("S3ArgumentError", "withCustomerKey: the key must be 32 bytes (64 hex characters)", None))
        }
        go! {
            sum := md5.Sum([]byte(raw))
            clone.SseKey = base64.StdEncoding.EncodeToString([]byte(raw))
            clone.SseKeyMd5 = base64.StdEncoding.EncodeToString(sum[:])
        }
        return Result.Ok(clone)
    }

    func hasCustomerKey(self) -> bool {
        return self.sseKey != ""
    }

    static func connect(cfg: S3Config) -> Result[S3Client] {
        _ = cfg.validate()?
        endpoint: str = S3.endpointUrl(cfg.endpoint)
        go! {
            awsCfg, err := config.LoadDefaultConfig(context.Background(),
                config.WithRegion(cfg.Region),
                config.WithCredentialsProvider(credentials.NewStaticCredentialsProvider(cfg.AccessKeyId, cfg.SecretAccessKey, "")),
            )
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3ConfigError", "load AWS configuration: %v", err))
            }
            client := NewS3Client()
            client.Cfg = cfg
            client.Raw = s3.NewFromConfig(awsCfg, func(o *s3.Options) {
                o.BaseEndpoint = aws.String(endpoint)
                o.UsePathStyle = cfg.UsePathStyle
            })
            client.Connected = true
            return LAMMERGEIER.Result.Ok(client)
        }
    }

    static func connect(accessKeyId: str, secretAccessKey: str, endpoint: str, bucket: str, region: str = "auto", publicEndpoint: str = "", usePathStyle: bool = true) -> Result[S3Client] {
        cfg: S3Config = S3Config(accessKeyId, secretAccessKey, endpoint, bucket, region, publicEndpoint, usePathStyle)
        return S3Client.connect(cfg)
    }

    static func fromEnv() -> Result[S3Client] {
        return S3Client.connect(S3Config.fromEnv())
    }

    func _ready(self) -> Result[bool] {
        _ = self.cfg.validate()?
        if not self.connected {
            return Result.Err(Error("S3ConfigError", "S3 client is not connected; use S3Client.connect() or S3Client.fromEnv()", None))
        }
        return Result.Ok(true)
    }

    func put(self, key: str, data: str, contentType: str = "text/plain") -> Result[bool] {
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            _, err := client.PutObject(context.Background(), &s3.PutObjectInput{
                SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                Bucket:      aws.String(s.Cfg.Bucket),
                Key:         aws.String(key),
                Body:        bytes.NewReader([]byte(data)),
                ContentType: aws.String(contentType),
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3PutError", "put %q: %v", key, err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func put(self, key: str, data: list[int], contentType: str = "application/octet-stream") -> Result[bool] {
        text: str = Bytes.fromBytes(data)
        return self.put(key, text, contentType)
    }

    func put(self, key: str, stream: any, contentType: str = "application/octet-stream") -> Result[bool] {
        return self.putStream(key, stream, contentType)
    }

    func putStream(self, key: str, stream: any, contentType: str = "application/octet-stream") -> Result[bool] {
        #- Upload from a native ``io.Reader``. Unambiguous spelling of the
           ``put(key, stream: any)`` overload for ``any``-typed values. -#
        _ = self._ready()?
        go! {
            reader, ok := stream.(io.Reader)
            if !ok {
                return LAMMERGEIER.Result.Err(s3Error("S3TypeError", "put stream %q: value does not implement io.Reader", key))
            }
            client := s.Raw.(*s3.Client)
            _, err := client.PutObject(context.Background(), &s3.PutObjectInput{
                SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                Bucket:      aws.String(s.Cfg.Bucket),
                Key:         aws.String(key),
                Body:        reader,
                ContentType: aws.String(contentType),
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3PutError", "put stream %q: %v", key, err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func uploadFile(self, localPath: str, key: str, contentType: str = "application/octet-stream") -> Result[bool] {
        _ = self._ready()?
        go! {
            f, err := os.Open(localPath)
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3FileError", "open %q: %v", localPath, err))
            }
            defer f.Close()
            client := s.Raw.(*s3.Client)
            _, err = client.PutObject(context.Background(), &s3.PutObjectInput{
                SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                Bucket:      aws.String(s.Cfg.Bucket),
                Key:         aws.String(key),
                Body:        f,
                ContentType: aws.String(contentType),
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3PutError", "upload %q to %q: %v", localPath, key, err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func get(self, key: str) -> Result[str] {
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            out, err := client.GetObject(context.Background(), &s3.GetObjectInput{
                SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                Bucket: aws.String(s.Cfg.Bucket),
                Key:    aws.String(key),
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3GetError", "get %q: %v", key, err))
            }
            defer out.Body.Close()
            data, err := s3ReadBody(out.Body, aws.ToInt64(out.ContentLength))
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3GetError", "read %q: %v", key, err))
            }
            return LAMMERGEIER.Result.Ok(string(data))
        }
    }

    func downloadFile(self, key: str, localPath: str) -> Result[bool] {
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            out, err := client.GetObject(context.Background(), &s3.GetObjectInput{
                SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                Bucket: aws.String(s.Cfg.Bucket),
                Key:    aws.String(key),
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3GetError", "download %q: %v", key, err))
            }
            defer out.Body.Close()
            // Stream to disk: an object can be far larger than memory.
            file, err := os.OpenFile(localPath, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0644)
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3FileError", "write %q: %v", localPath, err))
            }
            if _, err := io.Copy(file, out.Body); err != nil {
                file.Close()
                return LAMMERGEIER.Result.Err(s3Error("S3GetError", "read %q: %v", key, err))
            }
            if err := file.Close(); err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3FileError", "write %q: %v", localPath, err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func delete(self, key: str) -> Result[bool] {
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            _, err := client.DeleteObject(context.Background(), &s3.DeleteObjectInput{
                Bucket: aws.String(s.Cfg.Bucket),
                Key:    aws.String(key),
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3DeleteError", "delete %q: %v", key, err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func deleteMany(self, keys: list[str]) -> Result[int] {
        _ = self._ready()?
        if len(keys) == 0 {
            return Result.Ok(0)
        }
        go! {
            client := s.Raw.(*s3.Client)
            objects := make([]types.ObjectIdentifier, 0, len(keys))
            for _, key := range keys {
                objects = append(objects, types.ObjectIdentifier{Key: aws.String(key)})
            }
            out, err := client.DeleteObjects(context.Background(), &s3.DeleteObjectsInput{
                Bucket: aws.String(s.Cfg.Bucket),
                Delete: &types.Delete{Objects: objects, Quiet: aws.Bool(true)},
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3DeleteError", "delete %d objects: %v", len(keys), err))
            }
            if len(out.Errors) > 0 {
                msg := "unknown delete error"
                if out.Errors[0].Message != nil {
                    msg = *out.Errors[0].Message
                }
                return LAMMERGEIER.Result.Err(s3Error("S3DeleteError", "delete %d objects: %s", len(keys), msg))
            }
            return LAMMERGEIER.Result.Ok(len(keys))
        }
    }

    func exists(self, key: str) -> Result[bool] {
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            _, err := client.HeadObject(context.Background(), &s3.HeadObjectInput{
                SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                Bucket: aws.String(s.Cfg.Bucket),
                Key:    aws.String(key),
            })
            if err == nil {
                return LAMMERGEIER.Result.Ok(true)
            }
            var apiErr smithy.APIError
            if errors.As(err, &apiErr) && (apiErr.ErrorCode() == "NotFound" || apiErr.ErrorCode() == "NoSuchKey") {
                return LAMMERGEIER.Result.Ok(false)
            }
            return LAMMERGEIER.Result.Err(s3Error("S3HeadError", "exists %q: %v", key, err))
        }
    }

    func list(self, prefix: str = "") -> Result[list[S3Object]] {
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            out, err := client.ListObjectsV2(context.Background(), &s3.ListObjectsV2Input{
                Bucket: aws.String(s.Cfg.Bucket),
                Prefix: aws.String(prefix),
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3ListError", "list %q: %v", prefix, err))
            }
            result := make([]*S3Object, 0, len(out.Contents))
            for _, item := range out.Contents {
                obj := NewS3Object()
                if item.Key != nil {
                    obj.Key = *item.Key
                }
                if item.Size != nil {
                    obj.Size = int(*item.Size)
                }
                if item.ETag != nil {
                    obj.Etag = *item.ETag
                }
                if item.LastModified != nil {
                    obj.LastModified = item.LastModified.Format("2006-01-02T15:04:05Z07:00")
                }
                result = append(result, obj)
            }
            return LAMMERGEIER.Result.Ok(result)
        }
    }

    func keys(self, prefix: str = "") -> Result[list[str]] {
        items: list[S3Object] = self.list(prefix)?
        keys: list[str] = []
        for item in items {
            keys.append(item.key)
        }
        return Result.Ok(keys)
    }

    func stat(self, key: str) -> Result[S3Object] {
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            out, err := client.HeadObject(context.Background(), &s3.HeadObjectInput{
                SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                Bucket: aws.String(s.Cfg.Bucket),
                Key:    aws.String(key),
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3HeadError", "stat %q: %v", key, err))
            }
            obj := NewS3Object()
            obj.Key = key
            if out.ContentLength != nil {
                obj.Size = int(*out.ContentLength)
            }
            if out.ETag != nil {
                obj.Etag = *out.ETag
            }
            if out.LastModified != nil {
                obj.LastModified = out.LastModified.Format("2006-01-02T15:04:05Z07:00")
            }
            if out.ContentType != nil {
                obj.ContentType = *out.ContentType
            }
            obj.Metadata = out.Metadata
            return LAMMERGEIER.Result.Ok(obj)
        }
    }

    func copy(self, sourceKey: str, destKey: str, contentType: str = "") -> Result[bool] {
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            source := s.Cfg.Bucket + "/" + strings.ReplaceAll(url.PathEscape(sourceKey), "%2F", "/")
            input := &s3.CopyObjectInput{
                Bucket:     aws.String(s.Cfg.Bucket),
                Key:        aws.String(destKey),
                CopySource: aws.String(source),
                SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
            }
            if contentType != "" {
                input.ContentType = aws.String(contentType)
                input.MetadataDirective = types.MetadataDirectiveReplace
            }
            _, err := client.CopyObject(context.Background(), input)
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3CopyError", "copy %q to %q: %v", sourceKey, destKey, err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func copyFrom(self, sourceKey: str, destKey: str, sourceCustomerKey: str = "") -> Result[bool] {
        #- Server-side copy (up to 5 GiB) where the source may be encrypted
           with another customer key (``sourceCustomerKey``, 64 hex
           characters) than this client's. -#
        _ = self._ready()?
        source: S3Client = self.withCustomerKey(sourceCustomerKey)?
        go! {
            client := s.Raw.(*s3.Client)
            input := &s3.CopyObjectInput{
                Bucket:     aws.String(s.Cfg.Bucket),
                Key:        aws.String(destKey),
                CopySource: aws.String(s.Cfg.Bucket + "/" + strings.ReplaceAll(url.PathEscape(sourceKey), "%2F", "/")),
                SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                CopySourceSSECustomerAlgorithm: s3SseAlg(source.SseKey), CopySourceSSECustomerKey: s3Ptr(source.SseKey), CopySourceSSECustomerKeyMD5: s3Ptr(source.SseKeyMd5),
            }
            if _, err := client.CopyObject(context.Background(), input); err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3CopyError", "copy %q to %q: %v", sourceKey, destKey, err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func copyLarge(self, sourceKey: str, destKey: str, size: int, sourceCustomerKey: str = "", partSize: int = 1073741824) -> Result[bool] {
        #- Server-side multipart copy (``UploadPartCopy``) for objects of any
           size (a single copy is limited to 5 GiB). ``size`` is the source
           size; ``partSize`` at least 5 MiB. Stores that answer
           ``NotImplemented`` (no UploadPartCopy, or none with SSE-C) get a
           part-by-part copy through the client instead. Aborts the upload
           on failure. -#
        if size < 0 or partSize < 5242880 {
            return Result.Err(Error("S3ArgumentError", "copyLarge: size must be >= 0 and partSize at least 5 MiB", None))
        }
        if size <= partSize {
            return self.copyFrom(sourceKey, destKey, sourceCustomerKey)
        }
        _ = self._ready()?
        source: S3Client = self.withCustomerKey(sourceCustomerKey)?
        uploadId: str = self.createMultipartUpload(destKey)?
        failure: str = ""
        go! {
            client := s.Raw.(*s3.Client)
            copySource := aws.String(s.Cfg.Bucket + "/" + strings.ReplaceAll(url.PathEscape(sourceKey), "%2F", "/"))
            var parts []types.CompletedPart
            for number, offset := int32(1), 0; offset < size; number, offset = number+1, offset+partSize {
                last := offset + partSize - 1
                if last >= size {
                    last = size - 1
                }
                out, err := client.UploadPartCopy(context.Background(), &s3.UploadPartCopyInput{
                    Bucket:          aws.String(s.Cfg.Bucket),
                    Key:             aws.String(destKey),
                    UploadId:        aws.String(uploadId),
                    PartNumber:      aws.Int32(number),
                    CopySource:      copySource,
                    CopySourceRange: aws.String(fmt.Sprintf("bytes=%d-%d", offset, last)),
                    SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                    CopySourceSSECustomerAlgorithm: s3SseAlg(source.SseKey), CopySourceSSECustomerKey: s3Ptr(source.SseKey), CopySourceSSECustomerKeyMD5: s3Ptr(source.SseKeyMd5),
                })
                if err != nil {
                    failure = fmt.Sprintf("copy part %d of %q: %v", number, sourceKey, err)
                    break
                }
                parts = append(parts, types.CompletedPart{PartNumber: aws.Int32(number), ETag: out.CopyPartResult.ETag})
            }
            if failure == "" {
                _, err := client.CompleteMultipartUpload(context.Background(), &s3.CompleteMultipartUploadInput{
                    Bucket:          aws.String(s.Cfg.Bucket),
                    Key:             aws.String(destKey),
                    UploadId:        aws.String(uploadId),
                    MultipartUpload: &types.CompletedMultipartUpload{Parts: parts},
                    SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                })
                if err != nil {
                    failure = fmt.Sprintf("complete copy of %q: %v", sourceKey, err)
                }
            }
        }
        if failure != "" {
            _ = self.abortMultipartUpload(destKey, uploadId)
            if failure.contains("NotImplemented") {
                # Some S3-compatible stores lack UploadPartCopy (or lack it
                # with SSE-C): copy part by part through this client.
                return self._copyStreamed(source, sourceKey, destKey, size, partSize)
            }
            return Result.Err(Error("S3CopyError", failure, None))
        }
        return Result.Ok(true)
    }

    func _copyStreamed(self, source: S3Client, sourceKey: str, destKey: str, size: int, partSize: int) -> Result[bool] {
        uploadId: str = self.createMultipartUpload(destKey)?
        parts: list[S3Part] = []
        offset: int = 0
        number: int = 1
        while offset < size {
            length: int = size - offset
            if length > partSize {
                length = partSize
            }
            data: Result[bytes] = source.getRangeBytes(sourceKey, offset, length)
            if not data.ok() {
                _ = self.abortMultipartUpload(destKey, uploadId)
                return Result.Err(data.error)
            }
            uploaded: Result[S3Part] = self.uploadPart(destKey, uploadId, number, data.unwrap())
            if not uploaded.ok() {
                _ = self.abortMultipartUpload(destKey, uploadId)
                return Result.Err(uploaded.error)
            }
            parts.append(uploaded.unwrap())
            offset += length
            number += 1
        }
        completed: Result[bool] = self.completeMultipartUpload(destKey, uploadId, parts)
        if not completed.ok() {
            _ = self.abortMultipartUpload(destKey, uploadId)
            return completed
        }
        return Result.Ok(true)
    }

    func move(self, sourceKey: str, destKey: str, contentType: str = "") -> Result[bool] {
        copied: Result[bool] = self.copy(sourceKey, destKey, contentType)
        if not copied.ok() {
            return copied
        }
        deleted: Result[bool] = self.delete(sourceKey)
        if not deleted.ok() {
            return deleted
        }
        return Result.Ok(true)
    }

    func presignGet(self, key: str, expiresSeconds: int = 900) -> Result[str] {
        if self.sseKey != "" {
            return Result.Err(Error("S3ArgumentError", "presigned URLs cannot carry a customer encryption key (SSE-C)", None))
        }
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            presigner := s3.NewPresignClient(client)
            if expiresSeconds <= 0 {
                expiresSeconds = 900
            }
            out, err := presigner.PresignGetObject(context.Background(), &s3.GetObjectInput{
                Bucket: aws.String(s.Cfg.Bucket),
                Key:    aws.String(key),
            }, s3.WithPresignExpires(time.Duration(expiresSeconds)*time.Second))
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3PresignError", "presign GET %q: %v", key, err))
            }
            return LAMMERGEIER.Result.Ok(out.URL)
        }
    }

    func presignPut(self, key: str, contentType: str = "application/octet-stream", expiresSeconds: int = 900) -> Result[str] {
        if self.sseKey != "" {
            return Result.Err(Error("S3ArgumentError", "presigned URLs cannot carry a customer encryption key (SSE-C)", None))
        }
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            presigner := s3.NewPresignClient(client)
            if expiresSeconds <= 0 {
                expiresSeconds = 900
            }
            out, err := presigner.PresignPutObject(context.Background(), &s3.PutObjectInput{
                Bucket:      aws.String(s.Cfg.Bucket),
                Key:         aws.String(key),
                ContentType: aws.String(contentType),
            }, s3.WithPresignExpires(time.Duration(expiresSeconds)*time.Second))
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3PresignError", "presign PUT %q: %v", key, err))
            }
            return LAMMERGEIER.Result.Ok(out.URL)
        }
    }

    func put(self, key: str, data: bytes, contentType: str = "application/octet-stream") -> Result[bool] {
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            _, err := client.PutObject(context.Background(), &s3.PutObjectInput{
                SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                Bucket:        aws.String(s.Cfg.Bucket),
                Key:           aws.String(key),
                Body:          bytes.NewReader(data),
                ContentLength: aws.Int64(int64(len(data))),
                ContentType:   aws.String(contentType),
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3PutError", "put %q: %v", key, err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    # ── buckets ───────────────────────────────────────────────────────

    func bucketExists(self) -> Result[bool] {
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            _, err := client.HeadBucket(context.Background(), &s3.HeadBucketInput{Bucket: aws.String(s.Cfg.Bucket)})
            if err == nil {
                return LAMMERGEIER.Result.Ok(true)
            }
            if s3IsNotFound(err) {
                return LAMMERGEIER.Result.Ok(false)
            }
            return LAMMERGEIER.Result.Err(s3Error("S3BucketError", "head bucket %q: %v", s.Cfg.Bucket, err))
        }
    }

    func createBucket(self) -> Result[bool] {
        #- Create the configured bucket. ``Ok(false)`` when it already exists
           and is owned by these credentials. -#
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            _, err := client.CreateBucket(context.Background(), &s3.CreateBucketInput{Bucket: aws.String(s.Cfg.Bucket)})
            if err == nil {
                return LAMMERGEIER.Result.Ok(true)
            }
            var owned *types.BucketAlreadyOwnedByYou
            if errors.As(err, &owned) {
                return LAMMERGEIER.Result.Ok(false)
            }
            return LAMMERGEIER.Result.Err(s3Error("S3BucketError", "create bucket %q: %v", s.Cfg.Bucket, err))
        }
    }

    func ensureBucket(self) -> Result[bool] {
        #- Create the configured bucket when it does not exist yet. -#
        exists: bool = self.bucketExists()?
        if not exists {
            _ = self.createBucket()?
        }
        return Result.Ok(true)
    }

    # ── Object Lock (WORM retention and legal holds) ──────────────────

    func createBucketWithObjectLock(self) -> Result[bool] {
        #- Create the configured bucket with S3 Object Lock enabled (which
           also enables versioning; neither can be turned off later).
           ``Ok(false)`` when it already exists and is owned by these
           credentials: check ``objectLockConfig().enabled`` then. -#
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            _, err := client.CreateBucket(context.Background(), &s3.CreateBucketInput{Bucket: aws.String(s.Cfg.Bucket), ObjectLockEnabledForBucket: aws.Bool(true)})
            if err == nil {
                return LAMMERGEIER.Result.Ok(true)
            }
            var owned *types.BucketAlreadyOwnedByYou
            if errors.As(err, &owned) {
                return LAMMERGEIER.Result.Ok(false)
            }
            return LAMMERGEIER.Result.Err(s3Error("S3BucketError", "create bucket %q with object lock: %v", s.Cfg.Bucket, err))
        }
    }

    func objectLockConfig(self) -> Result[S3ObjectLockConfig] {
        #- The bucket's Object Lock configuration (``enabled`` false when the
           bucket has none). Use it at startup to check that a bucket meant
           for WORM data really has Object Lock. -#
        _ = self._ready()?
        out: S3ObjectLockConfig = S3ObjectLockConfig()
        failure: str = ""
        go! {
            client := s.Raw.(*s3.Client)
            res, err := client.GetObjectLockConfiguration(context.Background(), &s3.GetObjectLockConfigurationInput{Bucket: aws.String(s.Cfg.Bucket)})
            if err != nil {
                if !s3NoLockConfig(err) {
                    failure = fmt.Sprintf("object lock configuration of %q: %v", s.Cfg.Bucket, err)
                }
            } else if cfg := res.ObjectLockConfiguration; cfg != nil {
                out.Enabled = cfg.ObjectLockEnabled == types.ObjectLockEnabledEnabled
                if cfg.Rule != nil && cfg.Rule.DefaultRetention != nil {
                    d := cfg.Rule.DefaultRetention
                    out.DefaultMode = string(d.Mode)
                    out.DefaultDays = int(aws.ToInt32(d.Days))
                    out.DefaultYears = int(aws.ToInt32(d.Years))
                }
            }
        }
        if failure != "" {
            return Result.Err(Error("S3ObjectLockError", failure, None))
        }
        return Result.Ok(out)
    }

    func setObjectLockDefault(self, mode: str, days: int) -> Result[bool] {
        #- Sets the bucket's default retention (``mode`` GOVERNANCE or
           COMPLIANCE for ``days`` >= 1), or removes it with ``mode`` ``""``
           (Object Lock itself stays enabled). The bucket must have been
           created with Object Lock. -#
        upper: str = ""
        if mode != "" {
            upper = S3.checkLockMode(mode)?
            if days < 1 {
                return Result.Err(Error("S3ArgumentError", "setObjectLockDefault: days must be >= 1", None))
            }
        }
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            cfg := &types.ObjectLockConfiguration{ObjectLockEnabled: types.ObjectLockEnabledEnabled}
            if upper != "" {
                cfg.Rule = &types.ObjectLockRule{DefaultRetention: &types.DefaultRetention{Mode: types.ObjectLockRetentionMode(upper), Days: aws.Int32(int32(days))}}
            }
            _, err := client.PutObjectLockConfiguration(context.Background(), &s3.PutObjectLockConfigurationInput{Bucket: aws.String(s.Cfg.Bucket), ObjectLockConfiguration: cfg})
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3ObjectLockError", "set default retention of %q: %v", s.Cfg.Bucket, err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func setRetention(self, key: str, mode: str, untilUnix: int, bypassGovernance: bool = false, versionId: str = "") -> Result[bool] {
        #- Places, extends or changes the retention of ``key`` (its latest
           version, or ``versionId``): ``mode`` GOVERNANCE or COMPLIANCE
           until ``untilUnix``. ``mode`` ``""`` with ``untilUnix`` 0 removes
           a governance retention. Shortening or removing a governance
           retention needs ``bypassGovernance`` (and the
           ``s3:BypassGovernanceRetention`` permission); a compliance
           retention can only be extended. A refused change is
           ``S3ObjectLocked``. -#
        if key == "" {
            return Result.Err(Error("S3ArgumentError", "setRetention: key must not be empty", None))
        }
        upper: str = ""
        if mode != "" or untilUnix != 0 {
            upper = S3.checkLockMode(mode)?
            if untilUnix <= 0 {
                return Result.Err(Error("S3ArgumentError", f"setRetention {key}: untilUnix must be a Unix time in the future", None))
            }
        }
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            retention := &types.ObjectLockRetention{}
            if upper != "" {
                retention.Mode = types.ObjectLockRetentionMode(upper)
                retention.RetainUntilDate = aws.Time(time.Unix(int64(untilUnix), 0).UTC())
            }
            input := &s3.PutObjectRetentionInput{Bucket: aws.String(s.Cfg.Bucket), Key: aws.String(key), VersionId: s3VersionPtr(versionId), Retention: retention}
            if bypassGovernance {
                input.BypassGovernanceRetention = aws.Bool(true)
            }
            _, err := client.PutObjectRetention(context.Background(), input)
            if err != nil && upper == "" && (s3ErrorCode(err) == "InvalidRequest" || s3ErrorCode(err) == "MalformedXML") {
                // Stores that reject an empty retention (SeaweedFS) remove
                // it as a governance retention ending one second from now.
                input.Retention = &types.ObjectLockRetention{Mode: types.ObjectLockRetentionModeGovernance, RetainUntilDate: aws.Time(time.Now().Add(time.Second).UTC())}
                _, err = client.PutObjectRetention(context.Background(), input)
            }
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error(s3LockErrorKind(err, "S3ObjectLockError"), "set retention of %q: %v", key, err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func retention(self, key: str, versionId: str = "") -> Result[S3Retention] {
        #- The retention of ``key`` (latest version, or ``versionId``); an
           empty ``S3Retention`` when it has none. -#
        _ = self._ready()?
        out: S3Retention = S3Retention()
        failure: str = ""
        go! {
            client := s.Raw.(*s3.Client)
            res, err := client.GetObjectRetention(context.Background(), &s3.GetObjectRetentionInput{Bucket: aws.String(s.Cfg.Bucket), Key: aws.String(key), VersionId: s3VersionPtr(versionId)})
            if err != nil {
                if !s3NoLockConfig(err) {
                    failure = fmt.Sprintf("retention of %q: %v", key, err)
                }
            } else if res.Retention != nil {
                out.Mode = string(res.Retention.Mode)
                if res.Retention.RetainUntilDate != nil {
                    out.UntilUnix = int(res.Retention.RetainUntilDate.Unix())
                }
            }
        }
        if failure != "" {
            return Result.Err(Error("S3ObjectLockError", failure, None))
        }
        return Result.Ok(out)
    }

    func setLegalHold(self, key: str, on: bool, versionId: str = "") -> Result[bool] {
        #- Places (``on``) or releases a legal hold on ``key`` (latest
           version, or ``versionId``). A held version cannot be deleted, not
           even with a governance bypass, until the hold is released. -#
        if key == "" {
            return Result.Err(Error("S3ArgumentError", "setLegalHold: key must not be empty", None))
        }
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            status := types.ObjectLockLegalHoldStatusOff
            if on {
                status = types.ObjectLockLegalHoldStatusOn
            }
            _, err := client.PutObjectLegalHold(context.Background(), &s3.PutObjectLegalHoldInput{Bucket: aws.String(s.Cfg.Bucket), Key: aws.String(key), VersionId: s3VersionPtr(versionId), LegalHold: &types.ObjectLockLegalHold{Status: status}})
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error(s3LockErrorKind(err, "S3ObjectLockError"), "set legal hold of %q: %v", key, err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func legalHold(self, key: str, versionId: str = "") -> Result[bool] {
        #- Whether ``key`` (latest version, or ``versionId``) is under legal
           hold. -#
        _ = self._ready()?
        held: bool = false
        failure: str = ""
        go! {
            client := s.Raw.(*s3.Client)
            res, err := client.GetObjectLegalHold(context.Background(), &s3.GetObjectLegalHoldInput{Bucket: aws.String(s.Cfg.Bucket), Key: aws.String(key), VersionId: s3VersionPtr(versionId)})
            if err != nil {
                if !s3NoLockConfig(err) {
                    failure = fmt.Sprintf("legal hold of %q: %v", key, err)
                }
            } else if res.LegalHold != nil {
                held = res.LegalHold.Status == types.ObjectLockLegalHoldStatusOn
            }
        }
        if failure != "" {
            return Result.Err(Error("S3ObjectLockError", failure, None))
        }
        return Result.Ok(held)
    }

    func versions(self, prefix: str = "") -> Result[list[S3ObjectVersion]] {
        #- Every version and delete marker under ``prefix`` (all pages),
           newest first per key. In a versioned bucket (every Object Lock
           bucket) ``delete`` only adds a delete marker: free the space with
           ``deleteVersion``. -#
        _ = self._ready()?
        out: list[S3ObjectVersion] = []
        failure: str = ""
        go! {
            client := s.Raw.(*s3.Client)
            var keyMarker, versionMarker *string
            for {
                res, err := client.ListObjectVersions(context.Background(), &s3.ListObjectVersionsInput{Bucket: aws.String(s.Cfg.Bucket), Prefix: s3Ptr(prefix), KeyMarker: keyMarker, VersionIdMarker: versionMarker})
                if err != nil {
                    failure = fmt.Sprintf("list versions of %q: %v", prefix, err)
                    break
                }
                for _, v := range res.Versions {
                    item := NewS3ObjectVersion()
                    item.Key = aws.ToString(v.Key)
                    item.VersionId = aws.ToString(v.VersionId)
                    item.Size = int(aws.ToInt64(v.Size))
                    item.Etag = strings.Trim(aws.ToString(v.ETag), "\"")
                    if v.LastModified != nil {
                        item.LastModifiedUnix = int(v.LastModified.Unix())
                    }
                    item.IsLatest = aws.ToBool(v.IsLatest)
                    out = append(out, item)
                }
                for _, m := range res.DeleteMarkers {
                    item := NewS3ObjectVersion()
                    item.Key = aws.ToString(m.Key)
                    item.VersionId = aws.ToString(m.VersionId)
                    if m.LastModified != nil {
                        item.LastModifiedUnix = int(m.LastModified.Unix())
                    }
                    item.IsLatest = aws.ToBool(m.IsLatest)
                    item.IsDeleteMarker = true
                    out = append(out, item)
                }
                if !aws.ToBool(res.IsTruncated) {
                    break
                }
                keyMarker, versionMarker = res.NextKeyMarker, res.NextVersionIdMarker
            }
        }
        if failure != "" {
            return Result.Err(Error("S3ListError", failure, None))
        }
        return Result.Ok(out)
    }

    func deleteVersion(self, key: str, versionId: str, bypassGovernance: bool = false) -> Result[bool] {
        #- Permanently deletes one version (or delete marker) of ``key``.
           A version under retention or legal hold is refused with
           ``S3ObjectLocked``; ``bypassGovernance`` lifts a governance
           retention (never a compliance one or a legal hold). -#
        if key == "" or versionId == "" {
            return Result.Err(Error("S3ArgumentError", "deleteVersion: key and versionId must not be empty", None))
        }
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            input := &s3.DeleteObjectInput{Bucket: aws.String(s.Cfg.Bucket), Key: aws.String(key), VersionId: aws.String(versionId)}
            if bypassGovernance {
                input.BypassGovernanceRetention = aws.Bool(true)
            }
            if _, err := client.DeleteObject(context.Background(), input); err != nil {
                return LAMMERGEIER.Result.Err(s3Error(s3LockErrorKind(err, "S3DeleteError"), "delete version %s of %q: %v", versionId, key, err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    # ── ranged and streaming reads ────────────────────────────────────

    func getRangeBytes(self, key: str, offset: int, length: int) -> Result[bytes] {
        #- Read ``length`` bytes starting at ``offset`` (fewer at the end of
           the object). -#
        _ = S3.checkRange(key, offset, length)?
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            out, err := client.GetObject(context.Background(), &s3.GetObjectInput{
                SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                Bucket: aws.String(s.Cfg.Bucket),
                Key:    aws.String(key),
                Range:  aws.String(fmt.Sprintf("bytes=%d-%d", offset, offset+length-1)),
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3GetError", "get range %d+%d of %q: %v", offset, length, key, err))
            }
            defer out.Body.Close()
            data, err := s3ReadBody(io.LimitReader(out.Body, int64(length)), int64(length))
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3GetError", "read range of %q: %v", key, err))
            }
            return LAMMERGEIER.Result.Ok(data)
        }
    }

    func getRange(self, key: str, offset: int, length: int) -> Result[str] {
        #- ``getRangeBytes`` returning a binary-safe string. -#
        data: bytes = self.getRangeBytes(key, offset, length)?
        out: str = ""
        go! {
            out = string(data)
        }
        return Result.Ok(out)
    }

    func open(self, key: str, offset: int = 0, length: int = -1) -> Result[S3ObjectReader] {
        #- Stream the object from ``offset``; ``length < 0`` reads to the end. -#
        if key == "" {
            return Result.Err(Error("S3ArgumentError", "open: key must not be empty", None))
        }
        if offset < 0 or length == 0 {
            return Result.Err(Error("S3ArgumentError", f"open {key}: offset must be >= 0 and length non-zero", None))
        }
        _ = self._ready()?
        reader: S3ObjectReader = S3ObjectReader()
        reader.key = key
        reader.offset = offset
        go! {
            input := &s3.GetObjectInput{SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5), Bucket: aws.String(s.Cfg.Bucket), Key: aws.String(key)}
            if length > 0 {
                input.Range = aws.String(fmt.Sprintf("bytes=%d-%d", offset, offset+length-1))
            } else if offset > 0 {
                input.Range = aws.String(fmt.Sprintf("bytes=%d-", offset))
            }
            out, err := s.Raw.(*s3.Client).GetObject(context.Background(), input)
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3GetError", "open %q: %v", key, err))
            }
            reader.Raw = out.Body
            if out.ContentLength != nil {
                reader.Size = int(*out.ContentLength)
            }
            reader.ObjectSize = reader.Size
            if out.ContentRange != nil {
                if slash := strings.LastIndex(*out.ContentRange, "/"); slash >= 0 {
                    fmt.Sscanf((*out.ContentRange)[slash+1:], "%d", &reader.ObjectSize)
                }
            }
            if out.ContentType != nil {
                reader.ContentType = *out.ContentType
            }
            if out.ETag != nil {
                reader.Etag = *out.ETag
            }
        }
        return Result.Ok(reader)
    }

    # ── multipart uploads ─────────────────────────────────────────────

    func createMultipartUpload(self, key: str, contentType: str = "application/octet-stream") -> Result[str] {
        #- Start a multipart upload and return its upload id. -#
        if key == "" {
            return Result.Err(Error("S3ArgumentError", "createMultipartUpload: key must not be empty", None))
        }
        _ = self._ready()?
        go! {
            out, err := s.Raw.(*s3.Client).CreateMultipartUpload(context.Background(), &s3.CreateMultipartUploadInput{
                SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                Bucket:      aws.String(s.Cfg.Bucket),
                Key:         aws.String(key),
                ContentType: aws.String(contentType),
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3MultipartError", "create multipart upload %q: %v", key, err))
            }
            return LAMMERGEIER.Result.Ok(aws.ToString(out.UploadId))
        }
    }

    func uploadPart(self, key: str, uploadId: str, partNumber: int, data: bytes) -> Result[S3Part] {
        #- Upload part ``partNumber`` (1..10000). Every part except the last
           must be at least 5 MiB on AWS S3. -#
        _ = S3.checkPart(key, uploadId, partNumber)?
        _ = self._ready()?
        go! {
            out, err := s.Raw.(*s3.Client).UploadPart(context.Background(), &s3.UploadPartInput{
                SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                Bucket:        aws.String(s.Cfg.Bucket),
                Key:           aws.String(key),
                UploadId:      aws.String(uploadId),
                PartNumber:    aws.Int32(int32(partNumber)),
                Body:          bytes.NewReader(data),
                ContentLength: aws.Int64(int64(len(data))),
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3MultipartError", "upload part %d of %q: %v", partNumber, key, err))
            }
            return LAMMERGEIER.Result.Ok(NewS3Part(partNumber, aws.ToString(out.ETag), len(data)))
        }
    }

    func uploadPartReader(self, key: str, uploadId: str, partNumber: int, reader: any, size: int) -> Result[S3Part] {
        #- Upload part ``partNumber`` from a native ``io.ReadSeeker`` holding
           exactly ``size`` bytes (an ``*os.File``, an ``io.SectionReader``):
           the part is streamed, never held in memory, and re-read from the
           start when the SDK retries. -#
        _ = S3.checkPart(key, uploadId, partNumber)?
        if size < 0 {
            return Result.Err(Error("S3ArgumentError", f"multipart {key}: part size {size} is negative", None))
        }
        go! {
            if _, ok := reader.(io.ReadSeeker); !ok {
                return LAMMERGEIER.Result.Err(s3Error("S3TypeError", "upload part %d of %q: value does not implement io.ReadSeeker", partNumber, key))
            }
        }
        _ = self._ready()?
        go! {
            out, err := s.Raw.(*s3.Client).UploadPart(context.Background(), &s3.UploadPartInput{
                SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                Bucket:        aws.String(s.Cfg.Bucket),
                Key:           aws.String(key),
                UploadId:      aws.String(uploadId),
                PartNumber:    aws.Int32(int32(partNumber)),
                Body:          reader.(io.ReadSeeker),
                ContentLength: aws.Int64(int64(size)),
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3MultipartError", "upload part %d of %q: %v", partNumber, key, err))
            }
            return LAMMERGEIER.Result.Ok(NewS3Part(partNumber, aws.ToString(out.ETag), size))
        }
    }

    func uploadPartFile(self, key: str, uploadId: str, partNumber: int, localPath: str, offset: int = 0, length: int = -1) -> Result[S3Part] {
        #- Upload part ``partNumber`` from ``length`` bytes of a local file
           starting at ``offset`` (to the end of the file when ``length`` is
           negative), streamed from disk. -#
        _ = S3.checkPart(key, uploadId, partNumber)?
        if offset < 0 {
            return Result.Err(Error("S3ArgumentError", f"multipart {key}: file offset {offset} is negative", None))
        }
        file: any = None
        size: int = 0
        problem: str = ""
        go! {
            f, err := os.Open(localPath)
            if err != nil {
                problem = fmt.Sprintf("open %q: %v", localPath, err)
            } else if info, err := f.Stat(); err != nil {
                f.Close()
                problem = fmt.Sprintf("stat %q: %v", localPath, err)
            } else {
                size = int(info.Size()) - offset
                if length >= 0 && length < size {
                    size = length
                }
                if size < 0 {
                    size = 0
                }
                file = f
            }
        }
        if problem != "" {
            return Result.Err(Error("S3FileError", problem, None))
        }
        section: any = go!(io.NewSectionReader(file.(*os.File), int64(offset), int64(size)))
        uploaded: Result[S3Part] = self.uploadPartReader(key, uploadId, partNumber, section, size)
        go! {
            file.(*os.File).Close()
        }
        return uploaded
    }

    func uploadPart(self, key: str, uploadId: str, partNumber: int, data: str) -> Result[S3Part] {
        raw: bytes = go!([]byte(data))
        return self.uploadPart(key, uploadId, partNumber, raw)
    }

    func uploadPart(self, key: str, uploadId: str, partNumber: int, data: list[int]) -> Result[S3Part] {
        raw: bytes = go!([]byte(Bytes_fromBytes(data)))
        return self.uploadPart(key, uploadId, partNumber, raw)
    }

    func listParts(self, key: str, uploadId: str) -> Result[list[S3Part]] {
        #- Every part uploaded so far, in part-number order (follows pagination). -#
        _ = S3.checkPart(key, uploadId, 1)?
        _ = self._ready()?
        go! {
            client := s.Raw.(*s3.Client)
            parts := make([]*S3Part, 0)
            var marker *string
            for {
                out, err := client.ListParts(context.Background(), &s3.ListPartsInput{
                    Bucket:           aws.String(s.Cfg.Bucket),
                    Key:              aws.String(key),
                    UploadId:         aws.String(uploadId),
                    PartNumberMarker: marker,
                })
                if err != nil {
                    return LAMMERGEIER.Result.Err(s3Error("S3MultipartError", "list parts of %q: %v", key, err))
                }
                for _, p := range out.Parts {
                    parts = append(parts, NewS3Part(int(aws.ToInt32(p.PartNumber)), aws.ToString(p.ETag), int(aws.ToInt64(p.Size))))
                }
                if !aws.ToBool(out.IsTruncated) || out.NextPartNumberMarker == nil {
                    break
                }
                marker = out.NextPartNumberMarker
            }
            return LAMMERGEIER.Result.Ok(parts)
        }
    }

    func completeMultipartUpload(self, key: str, uploadId: str, parts: list[S3Part]) -> Result[bool] {
        #- Assemble the uploaded parts (ascending part numbers) into the object. -#
        _ = S3.checkPart(key, uploadId, 1)?
        if len(parts) == 0 {
            return Result.Err(Error("S3ArgumentError", f"complete {key}: at least one part is required", None))
        }
        previous: int = 0
        for part in parts {
            if part.partNumber <= previous or part.partNumber > S3.maxParts() {
                return Result.Err(Error("S3ArgumentError", f"complete {key}: part numbers must be ascending within 1..{S3.maxParts()}", None))
            }
            previous = part.partNumber
        }
        _ = self._ready()?
        go! {
            completed := make([]types.CompletedPart, 0, len(parts))
            for _, p := range parts {
                completed = append(completed, types.CompletedPart{PartNumber: aws.Int32(int32(p.PartNumber)), ETag: aws.String(p.Etag)})
            }
            _, err := s.Raw.(*s3.Client).CompleteMultipartUpload(context.Background(), &s3.CompleteMultipartUploadInput{
                Bucket:          aws.String(s.Cfg.Bucket),
                SSECustomerAlgorithm: s3SseAlg(s.SseKey), SSECustomerKey: s3Ptr(s.SseKey), SSECustomerKeyMD5: s3Ptr(s.SseKeyMd5),
                Key:             aws.String(key),
                UploadId:        aws.String(uploadId),
                MultipartUpload: &types.CompletedMultipartUpload{Parts: completed},
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3MultipartError", "complete multipart upload %q: %v", key, err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func abortMultipartUpload(self, key: str, uploadId: str) -> Result[bool] {
        #- Discard an unfinished multipart upload and its stored parts. -#
        _ = S3.checkPart(key, uploadId, 1)?
        _ = self._ready()?
        go! {
            _, err := s.Raw.(*s3.Client).AbortMultipartUpload(context.Background(), &s3.AbortMultipartUploadInput{
                Bucket:   aws.String(s.Cfg.Bucket),
                Key:      aws.String(key),
                UploadId: aws.String(uploadId),
            })
            if err != nil {
                return LAMMERGEIER.Result.Err(s3Error("S3MultipartError", "abort multipart upload %q: %v", key, err))
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func publicUrl(self, key: str) -> str {
        return S3.publicUrl(self.cfg.publicEndpoint, key)
    }
}

class S3 {
    static func endpointUrl(endpoint: str) -> str {
        #- API endpoint URL handed to the SDK. An explicit ``http://`` or
           ``https://`` scheme is kept (local MinIO/SeaweedFS gateways use
           plain HTTP); a bare host defaults to HTTPS. -#
        trimmed: str = endpoint.trim()
        lower: str = trimmed.toLower()
        scheme: str = "https://"
        if lower.startsWith("http://") {
            scheme = "http://"
        }
        host: str = S3.normalizeEndpoint(trimmed)
        if host == "" {
            return ""
        }
        return scheme + host
    }

    static func maxParts() -> int {
        return 10000
    }

    static func checkPart(key: str, uploadId: str, partNumber: int) -> Result[bool] {
        if key == "" {
            return Result.Err(Error("S3ArgumentError", "multipart: key must not be empty", None))
        }
        if uploadId == "" {
            return Result.Err(Error("S3ArgumentError", f"multipart {key}: upload id must not be empty", None))
        }
        if partNumber < 1 or partNumber > S3.maxParts() {
            return Result.Err(Error("S3ArgumentError", f"multipart {key}: part number {partNumber} is outside 1..{S3.maxParts()}", None))
        }
        return Result.Ok(true)
    }

    static func checkLockMode(mode: str) -> Result[str] {
        #- ``mode`` as S3 spells it (``GOVERNANCE`` / ``COMPLIANCE``, any
           case accepted); ``S3ArgumentError`` for anything else. -#
        upper: str = mode.trim().toUpper()
        if upper != "GOVERNANCE" and upper != "COMPLIANCE" {
            return Result.Err(Error("S3ArgumentError", f"object lock mode must be GOVERNANCE or COMPLIANCE, not '{mode}'", None))
        }
        return Result.Ok(upper)
    }

    static func checkRange(key: str, offset: int, length: int) -> Result[bool] {
        if key == "" {
            return Result.Err(Error("S3ArgumentError", "range read: key must not be empty", None))
        }
        if offset < 0 or length <= 0 {
            return Result.Err(Error("S3ArgumentError", f"range read {key}: offset must be >= 0 and length > 0", None))
        }
        return Result.Ok(true)
    }

    static func normalizeEndpoint(endpoint: str) -> str {
        out: str = endpoint.trim()
        lower: str = out.toLower()
        if lower.startsWith("https://") {
            out = out[8:]
        } elif lower.startsWith("http://") {
            out = out[7:]
        }
        return out.trimRight("/")
    }

    static func publicUrl(publicEndpoint: str, key: str) -> str {
        endpoint: str = S3.normalizeEndpoint(publicEndpoint)
        if endpoint == "" {
            return ""
        }
        escaped: str = go!(url.PathEscape(key))
        escaped = escaped.replace("%2F", "/")
        return "https://" + endpoint + "/" + escaped
    }

    static func hasEnv() -> bool {
        return S3Config.fromEnv().isReady()
    }
}
