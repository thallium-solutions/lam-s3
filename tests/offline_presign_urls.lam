# expect: true
# expect: https://cdn.example.com/assets/lam-s3-tests/presigned/file%20name.txt

from @lam/s3 import S3Client
from @lam/s3 import S3Config
from lamerrors import Result

func main() {
    cfg: S3Config = S3Config(
        "key",
        "secret",
        "account.r2.cloudflarestorage.com",
        "bucket",
        "auto",
        "cdn.example.com/assets",
        true,
    )
    client: S3Client = S3Client.connect(cfg)?
    key: str = "lam-s3-tests/presigned/file name.txt"

    getRes: Result[str] = client.presignGet(key, 60)
    getUrl: str = getRes?
    print(getRes.ok())
    print(getUrl.contains("lam-s3-tests/presigned/file%20name.txt"))
    print(getUrl.contains("X-Amz-Signature="))

    putRes: Result[str] = client.presignPut(key, "text/plain", 60)
    putUrl: str = putRes?
    print(putRes.ok() and putUrl.contains("X-Amz-Signature="))
    signedUrl: str = client.presignGet(key, 60)?
    print(signedUrl.contains("X-Amz-Signature="))
    print(client.publicUrl(key))
}
