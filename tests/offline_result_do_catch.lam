# expect: S3ConfigError
# expect: caught S3ConfigError
# expect: ready true
# expect: false
# expect: S3ConfigError
# expect: true
# expect: true
# expect: true
# expect: result_do_catch_ok

from @lam/s3 import S3Client
from @lam/s3 import S3Config
from @lam/s3 import S3Object
from lamerrors import Result, Error

func requireReady(cfg: S3Config) -> Result[bool] {
    ready: Result[bool] = cfg.validate()
    if not ready.ok() {
        return ready
    }
    return Result.Ok(true)
}

func main() {
    empty: S3Config = S3Config()
    missing: Result[bool] = empty.validate()
    err: Error = missing.error
    print(err.kind)

    do {
        ready: bool = empty.validate()?
        print(f"unexpected {ready}")
    } catch caught {
        kind: str = str(caught).split(":")[0]
        print(f"caught {kind}")
    }

    cfg: S3Config = S3Config()
    cfg.accessKeyId = "key"
    cfg.secretAccessKey = "secret"
    cfg.endpoint = "account.r2.cloudflarestorage.com"
    cfg.region = "auto"
    cfg.bucket = "bucket"

    readyRes: Result[bool] = requireReady(cfg)
    print(f"ready {readyRes.ok()}")

    failedFactory: Result[S3Client] = S3Client.connect(empty)
    factoryError: Error = failedFactory.error
    print(failedFactory.ok())
    print(factoryError.kind)

    disconnected: S3Client = S3Client()
    textPut: Result[bool] = disconnected.put("text.txt", "text")
    bufferPut: Result[bool] = disconnected.put("bytes.bin", [0, 1, 255])
    body: Result[str] = disconnected.get("text.txt")
    objects: Result[list[S3Object]] = disconnected.list()
    keys: Result[list[str]] = disconnected.keys()
    print(not textPut.ok() and not bufferPut.ok())
    print(not body.ok() and not objects.ok())
    print(not keys.ok())
    print("result_do_catch_ok")
}
