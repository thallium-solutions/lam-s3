# Clients built with blockPrivateNetworks refuse private and reserved
# addresses at connection time (after DNS resolution).
#
# expect: loopback-refused=true
# expect: message-names-guard=true
# expect: metadata-refused=true
# expect: name-to-loopback-refused=true
# expect: default-client-tries=true
# expect: public: 8.8.8.8=true 2606:4700::1111=true
# expect: private: 10.1.2.3=false 172.20.0.1=false 192.168.1.1=false 100.64.0.1=false
# expect: reserved: 127.0.0.1=false 169.254.169.254=false ::1=false fd00::1=false fe80::1=false 0.0.0.0=false ::ffff:10.0.0.1=false

from lamerrors import Result
from @lam/s3 import S3, S3Client, S3Config

func guarded(endpoint: str) -> S3Client {
    cfg: S3Config = S3Config("key", "secret", endpoint, "bucket", "us-east-1")
    cfg.blockPrivateNetworks = true
    return S3Client.connect(cfg).unwrap()
}

func main() {
    loop: Result[bool] = guarded("http://127.0.0.1:9").exists("k")
    print(f"loopback-refused={not loop.ok()}")
    print(f"message-names-guard={str(loop.error).contains('blockPrivateNetworks')}")
    meta: Result[bool] = guarded("http://169.254.169.254").exists("k")
    print(f"metadata-refused={not meta.ok() and str(meta.error).contains('private or reserved')}")
    named: Result[bool] = guarded("http://localhost:9").exists("k")
    print(f"name-to-loopback-refused={not named.ok() and str(named.error).contains('private or reserved')}")
    plain: S3Client = S3Client.connect(S3Config("key", "secret", "http://127.0.0.1:9", "bucket", "us-east-1")).unwrap()
    tried: Result[bool] = plain.exists("k")
    print(f"default-client-tries={not tried.ok() and not str(tried.error).contains('blockPrivateNetworks')}")
    print(f"public: 8.8.8.8={S3.isPublicAddress('8.8.8.8')} 2606:4700::1111={S3.isPublicAddress('2606:4700::1111')}")
    print(f"private: 10.1.2.3={S3.isPublicAddress('10.1.2.3')} 172.20.0.1={S3.isPublicAddress('172.20.0.1')} 192.168.1.1={S3.isPublicAddress('192.168.1.1')} 100.64.0.1={S3.isPublicAddress('100.64.0.1')}")
    print(f"reserved: 127.0.0.1={S3.isPublicAddress('127.0.0.1')} 169.254.169.254={S3.isPublicAddress('169.254.169.254')} ::1={S3.isPublicAddress('::1')} fd00::1={S3.isPublicAddress('fd00::1')} fe80::1={S3.isPublicAddress('fe80::1')} 0.0.0.0={S3.isPublicAddress('0.0.0.0')} ::ffff:10.0.0.1={S3.isPublicAddress('::ffff:10.0.0.1')}")
}
