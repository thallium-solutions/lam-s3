# expect: put=true
# expect: body=true
# expect: copy_body=true
# expect: moved_exists=true
# expect: list_has_moved=true
# expect: upload_download=true
# expect: buffer=true
# expect: stream=true
# expect: stat=true
# expect: presign=true
# expect: cleanup=true
# expect: live_roundtrip_ok

from @lam/s3 import S3
from @lam/s3 import S3Client
from @lam/s3 import S3Object
from lambytes import Bytes
from lamos import Os

go! {
    import (
        "os"
        "strings"
    )
}

func hasKey(keys: list[str], wanted: str) -> bool {
    for key in keys {
        if key == wanted {
            return true
        }
    }
    return false
}

func main() {
    liveEnabled: bool = go!(os.Getenv("LAM_S3_LIVE_TESTS") == "1")
    if not liveEnabled {
        print("skip: set LAM_S3_LIVE_TESTS=1 to run live S3 tests")
        return
    }

    if not S3.hasEnv() {
        print("missing S3 env")
        return
    }

    client: S3Client = S3Client.fromEnv()?
    prefix: str = "lam-s3-tests/live-roundtrip/"
    key: str = prefix + "hello.txt"
    copyKey: str = prefix + "hello-copy.txt"
    movedKey: str = prefix + "hello-moved.txt"
    uploadKey: str = prefix + "uploaded.txt"
    bufferKey: str = prefix + "buffer.bin"
    streamKey: str = prefix + "stream.txt"
    preCleanKeys: list[str] = [key, copyKey, movedKey, uploadKey, bufferKey, streamKey]
    cleanupKeys: list[str] = [key, movedKey, uploadKey, bufferKey, streamKey]
    body: str = "hello from @lam/s3"

    _ = client.deleteMany(preCleanKeys)

    putOk: bool = client.put(key, body, "text/plain").ok()
    print(f"put={putOk}")

    got: str = client.get(key)?
    print(f"body={got == body}")

    copyOk: bool = client.copy(key, copyKey, "text/plain").ok()
    _ = copyOk
    copied: str = client.get(copyKey)?
    print(f"copy_body={copied == body}")

    movedOk: bool = client.move(copyKey, movedKey, "text/plain").ok()
    _ = movedOk
    movedExists: bool = client.exists(movedKey)?
    oldCopyExists: bool = client.exists(copyKey)?
    print(f"moved_exists={movedExists and not oldCopyExists}")

    keys: list[str] = client.keys(prefix)?
    print(f"list_has_moved={hasKey(keys, movedKey)}")

    tmpIn: str = Os.tempFile("lam-s3-upload-", ".txt")?
    tmpOut: str = Os.tempFile("lam-s3-download-", ".txt")?
    Os.writeFile(tmpIn, "file body")?
    uploadOk: bool = client.uploadFile(tmpIn, uploadKey, "text/plain").ok()
    downloadOk: bool = client.downloadFile(uploadKey, tmpOut).ok()
    downloaded: str = Os.readFile(tmpOut)?
    print(f"upload_download={uploadOk and downloadOk and downloaded == 'file body'}")
    Os.remove(tmpIn)?
    Os.remove(tmpOut)?

    buffer: list[int] = [0, 1, 2, 255]
    bufferOk: bool = client.put(bufferKey, buffer, "application/octet-stream").ok()
    roundBuffer: list[int] = Bytes.toBytes(client.get(bufferKey)?)
    print(f"buffer={bufferOk and len(roundBuffer) == 4 and roundBuffer[3] == 255}")

    stream: any = go!(strings.NewReader("stream body"))
    streamOk: bool = client.put(streamKey, stream, "text/plain").ok()
    streamBody: str = client.get(streamKey)?
    print(f"stream={streamOk and streamBody == 'stream body'}")

    obj: S3Object = client.stat(key)?
    print(f"stat={obj.key == key and obj.size == len(body) and obj.contentType == 'text/plain'}")

    signedUrl: str = client.presignGet(key, 60)?
    print(f"presign={signedUrl.contains('X-Amz-Signature=')}")

    deleted: int = client.deleteMany(cleanupKeys)?
    print(f"cleanup={deleted == len(cleanupKeys)}")
    print("live_roundtrip_ok")
}
