# expect: false
# expect: false
# expect: auto
# expect: true
# expect: true
# expect: us-east-1
# expect: false
# expect: bucket
# expect: true

from @lam/s3 import S3
from @lam/s3 import S3Config

go! {
    import "os"
}

func clearS3Env() {
    go! {
        os.Unsetenv("S3_ACCESS_KEY_ID")
        os.Unsetenv("S3_SECRET_ACCESS_KEY")
        os.Unsetenv("S3_ENDPOINT")
        os.Unsetenv("S3_PUBLIC_ENDPOINT")
        os.Unsetenv("S3_REGION")
        os.Unsetenv("S3_BUCKET")
        os.Unsetenv("S3_USE_PATH_STYLE")
    }
}

func main() {
    clearS3Env()

    empty: S3Config = S3Config.fromEnv()
    print(empty.isReady())
    print(S3.hasEnv())
    print(empty.region)
    print(empty.usePathStyle)

    go! {
        os.Setenv("S3_ACCESS_KEY_ID", "key")
        os.Setenv("S3_SECRET_ACCESS_KEY", "secret")
        os.Setenv("S3_ENDPOINT", "account.r2.cloudflarestorage.com")
        os.Setenv("S3_PUBLIC_ENDPOINT", "cdn.example.com")
        os.Setenv("S3_REGION", "us-east-1")
        os.Setenv("S3_BUCKET", "bucket")
        os.Setenv("S3_USE_PATH_STYLE", "false")
    }

    ready: S3Config = S3Config.fromEnv()
    print(ready.isReady())
    print(ready.region)
    print(ready.usePathStyle)
    print(ready.bucket)
    print(S3.hasEnv())

    clearS3Env()
}
